# Avela — Root Environment Variables
# Copy to .env and fill in real values
# App-specific vars: see apps/{api,web,site}/.env.example

# Database (Supabase Postgres)
DATABASE_URL=postgres://user:password@host:5432/avela
TEST_DATABASE_URL=postgres://user:password@localhost:5432/avela_test

# Privy Auth (https://dashboard.privy.io)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# X Layer RPC
XLAYER_RPC_URL=https://rpc.xlayer.tech

# Contract Deployment (Foundry)
PRIVATE_KEY=
ETHERSCAN_API_KEY=

# OKX (optional — future integrations)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
