# Avela — Root Environment Variables
# Copy to .env and fill in real values
# App-specific vars: see apps/{api,web,site}/.env.example

# Supabase (https://supabase.com/dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Database (Supabase → Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
TEST_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Privy Auth (https://dashboard.privy.io)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# X Layer RPC
XLAYER_RPC_URL=https://rpc.xlayer.tech

# Contract Deployment (Foundry)
PRIVATE_KEY=
ETHERSCAN_API_KEY=

# Deployed Contracts (X Layer mainnet, chain ID 196)
AVELA_VAULT_ADDRESS=0x3479183bcbcC3643fDb6a26C7215e602095C2086
AVELA_ROUTER_ADDRESS=0x6986CF2784f112bc1610ee743F33246d9C4B869B
