# Avela Web Dashboard — Environment Variables
# Copy to .env.local and fill in real values

# Privy Auth (https://dashboard.privy.io — same App ID as API)
NEXT_PUBLIC_PRIVY_APP_ID=

# API URL (Avela backend)
# Local: http://localhost:3001 — Production (live on Render): https://api.useavela.xyz
NEXT_PUBLIC_API_URL=http://localhost:3001
