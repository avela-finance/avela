# Avela API — Environment Variables
# Copy to .env and fill in real values

# Database (Supabase Postgres)
DATABASE_URL=postgres://user:password@host:5432/avela

# Privy Auth (https://dashboard.privy.io)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# X Layer RPC
XLAYER_RPC_URL=https://rpc.xlayer.tech

# Server
PORT=3001

# WhatsApp Business API (optional — needed for WhatsApp integration)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
